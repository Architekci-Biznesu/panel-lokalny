# --- Faza 1: fundament ---
DATABASE_URL=postgresql://user:password@host/dbname
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# --- AI (Faza 2+) ---
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
AI_TEXT_PROVIDER=openai
AI_IMAGE_PROVIDER=openai

# --- Google Business Profile OAuth (Faza 2) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/gbp/callback

# Places API (New) - autocomplete regionów dla obszaru obsługi wizytówki
GOOGLE_PLACES_API_KEY=

# 32-byte key as base64 (openssl rand -base64 32) - encrypts OAuth tokens at rest
TOKEN_ENCRYPTION_KEY=

# --- Późniejsze fazy (odkomentuj gdy potrzebne) ---
# REDIS_URL=redis://localhost:6379
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# BREVO_API_KEY=
# SMSAPI_TOKEN=

# --- Faza 3b: mapa pozycji (ScrapingDog) ---
SCRAPINGDOG_API_KEY=

# --- Faza 4: publikacje (Cloudflare R2) ---
# Publiczny adres grafiki = ${R2_PUBLIC_BASE_URL}/${key}. Lokalnie *.r2.dev, produkcyjnie własna subdomena.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Testy Opinii (npm run test:reviews) - osobna gałąź Neon "test", NIE produkcja.
# Test czyści tę bazę na starcie. Adres: Neon > Connect > gałąź "test".
TEST_DATABASE_URL=
# Zgoda na bazę spoza localhost: musi być innym endpointem niż DATABASE_URL, a test
# przerwie, jeśli znajdzie w niej konto spoza @test.pl
TEST_DATABASE_ALLOW_REMOTE=
